if {[isEagle]} then {
  apply [list [list] {
    # <help>
    # This procedure is used to dump complaints to the test log file at
    # the end of a test suite run.
    # </help>

    if {[catch {
      object invoke -flags +NonPublic \
          Eagle._Components.Private.DebugOps complaints.Count
    } count] == 0 && $count > 0} then {
      if {[info exists ::test_log]} then {
        set fileName [appendArgs $::test_log .complaints]
      } else {
        set fileName [appendArgs [file tempname] .complaints]
      }

      set message [appendArgs "COMPLAINTS TEST-RUN " [getTestRunTag]]

      set result [object invoke -flags +NonPublic \
          Eagle._Components.Private.DebugOps DumpComplaints "" null \
          $fileName $message true]

      if {$result > 0} then {
        host result Ok [appendArgs \
            ">>>> success dumping " $count " complaints to file \"" \
            $fileName \"\n]
      } else {
        host result Error [appendArgs \
            ">>>> failure dumping " $count " complaints to file \"" \
            $fileName \"\n]
      }

      if {![info exists ::no(logRemoteComplaints)]} then {
        logRemoteMessageFile $fileName
      }

      return $fileName
    }

    return ""
  }]
}
