###############################################################################

source [file join [file normalize [file dirname [info script]]] prologue.eagle]

###############################################################################

runTest {test debug-2.1 {isolated evaluation} -body {
  set x 1
  debug eval set x 2
  debug eval incr x
  list [set x] [debug eval set x]
} -cleanup {
  catch {debug eval unset -nocomplain x}
  unset -nocomplain x
} -constraints \
{eagle compile.DEBUGGER scriptDebugger scriptDebuggerInterpreter} \
-result {1 3}}

###############################################################################

runTest {test debug-2.35 {IScriptLocation stack balance} -setup {
  set fileName [file join [getTemporaryPath] debug-2.35.eagle]

  writeFile $fileName {
    eval {
      object invoke -flags +NonPublic \
          Interpreter.GetActive EnableScriptLocation true
    }
  }

  set i [interp create -nosecurity]
} -body {
  interp eval $i [list source $fileName]
} -cleanup {
  catch {interp delete $i}

  catch {file delete $fileName}

  unset -nocomplain i fileName
} -constraints \
{eagle command.object compile.DEBUGGER compile.DEBUGGER_BREAKPOINTS} \
-result {}}

###############################################################################

if {[isEagle]} then {
  set debugStatus(before) [string map \
      [list \r\n \n] [debug emergency status]]

  tputs $test_channel [appendArgs \
      "---- debug status before: \{\n\t" [string map \
      [list \n \n\t] [string trim $debugStatus(before)]] \
      \n\}\n]
}

###############################################################################

runTest {test debug-2.86.1 {ScriptArguments stack balance} -setup {
  set i [interp create]
} -body {
  string map [list \r\n \n] [interp eval $i {
    debug emergency {full -break}
  }]
} -cleanup {
  catch {
    debug emergency {
      :Reset PopulateResultStack IncludeResultStack
    }
  }

  catch {interp delete $i}

  unset -nocomplain i
} -constraints {eagle command.object compile.SCRIPT_ARGUMENTS} -result \
{emergency mode now is enabled
debugger created
populate result stack traces is enabled
include result stack traces is enabled
script cancellation not reset
interpreter halt state not reset
debugger types are missing
debugger types added
debugger is enabled
debugger break-on-token is enabled
interactive mode is enabled
script locations is enabled
argument locations is enabled
script arguments is enabled
interactive loop hooked
}}

###############################################################################

if {[isEagle]} then {
  set debugStatus(after) [string map \
      [list \r\n \n] [debug emergency status]]

  tputs $test_channel [appendArgs \
      "---- debug status after: \{\n\t" [string map \
      [list \n \n\t] [string trim $debugStatus(after)]] \
      \n\}\n]
}

###############################################################################

runTest {test debug-2.86.2 {verify debug status match} -body {
  if {[info exists debugStatus(before)] && \
      [info exists debugStatus(after)]} then {
    list [expr {
      $debugStatus(before) eq $debugStatus(after)
    }]
  } else {
    list False
  }
} -cleanup {
  unset -nocomplain debugStatus
} -constraints {eagle compile.DEBUGGER compile.DEBUGGER_BREAKPOINTS} -result \
{True}}

###############################################################################

catch {unset -nocomplain debugStatus}

###############################################################################

if {[isEagle]} then {
  catch {purgeAndCleanup $test_channel post-debug-2.86}
}

###############################################################################

runTest {test debug-2.87 {PathDictionary.GetEnumerator exception} -setup {
  set i [interp create]
} -body {
  set o null; set error null

  set code [object invoke \
      -alias Value GetInterpreter "" $i Default o error]

  if {$code ne "Ok"} then {
    error [getStringFromObjectHandle $error]
  }

  catch {
    object invoke -flags +NonPublic $o EnableScriptLocation true
  }

  interp eval $i {
    debug emergency "enabled created tokens"
  }

  list [catch {
    interp eval $i {not_a_valid_command}
  } error] $error
} -cleanup {
  catch {interp delete $i}

  unset -nocomplain i o error code
} -constraints {eagle command.object} -result \
{1 {invalid command name "not_a_valid_command"}}}

###############################################################################

source [file join [file normalize [file dirname [info script]]] epilogue.eagle]
