      [$test intField] [set pVar] [set pVar 43] \
      [set iVar] [$test SimpleIntProperty] [incr iVar] \
      [$test intField] [$test SimpleIntProperty] \
      [$test -flags +NonPublic privateField] \
      [$test -flags +NonPublic objectField]
