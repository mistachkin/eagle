      [list %test_run_id% [getTestRunId]] {
    # test basic-1.110 (TEST-RUN %test_run_id%)
    set eagle_platform(interpreterTimeStamp)
  }]]

  list [getDictionaryValue $result returnCode] \
      [getDictionaryValue $result result]
} -cleanup {
