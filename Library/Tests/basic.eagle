      tputs $test_channel [appendArgs \
          "---- TestUnsetVariableLinks error: " \
          \n [getStringFromObjectHandle $error] \n]
    }
  }

  unset -nocomplain i pVar iVar oVar sVar code error test
} -constraints {eagle command.object compile.TEST\
