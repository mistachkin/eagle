runTest {test basic-1.1 {end-of-file character in source file} -setup {
  unset -nocomplain x
} -body {
  source [file join $test_data_path source.eagle]
} -cleanup {
  unset -nocomplain x
} -constraints {file_source.eagle} -result {{this is a test...}}}

