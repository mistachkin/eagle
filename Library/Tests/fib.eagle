###############################################################################

source [file join [file normalize [file dirname [info script]]] prologue.eagle]

###############################################################################

runTest {test fib-1.1 {recursive fibonacci sequence (integer)} -setup {
  proc fib {x} {
    if {$x <= 2} then {
      return 1
    } else {
      return [expr {[fib [expr {$x - 1}]] + [fib [expr {$x - 2}]]}]
    }
  }
} -body {
  fib 10
} -cleanup {
  rename fib ""
} -result {55}}

###############################################################################

runTest {test fib-1.2 {iterative fibonacci sequence (entier)} -setup {
  proc fib {x} {
    set z 1
    if {$x > 2} then {
      set y 0
      for {set i 2} {$i <= $x} {incr i} {
        set t [expr {entier($y) + $z}]
        set y $z; set z $t
      }
    }
    return $z
  }
} -body {
  fib 10000
} -constraints {tip237 bigIntegers} -cleanup {
  rename fib ""
} -result [appendArgs {33644764876431783266621612005107543310302148460680063} \
