###############################################################################

source [file join [file normalize [file dirname [info script]]] prologue.eagle]

###############################################################################

runTest {test remote-1.1 {logRemoteMessage test suite helper} -setup {
  package require Eagle.Test
} -body {
  if {[info exists ::env(logRemoteMessagePassword)]} then {
    logRemoteMessage [appendArgs \
        "TEST '" $eagle_tests(CurrentName) "' MESSAGE - " [getTestRunTag]]
  } else {
    list OK 0; # There is no logging password, just "succeed".
  }
} -constraints {eagle tlsOk internet_urn.to} -match regexp -result {^OK \d+$}}

###############################################################################

runTest {test aplus-1.1 {a+ file open mode} -setup {
  set file [file join [getTemporaryPath] aplus-1-1.txt]

  set fd [open $file w]
  fconfigure $fd -translation lf
  puts $fd "1\n2\n3\n4\n5"
  # puts $fd "1\r\n2\r\n3\r\n4\r\n5"
  close $fd
} -body {
  set fd [open $file a+]
  fconfigure $fd -translation lf
  seek $fd -4 end
  puts $fd "here"
  close $fd

  set fd [open $file r]
  fconfigure $fd -translation binary
  set data [read $fd]
  close $fd

  set data
} -cleanup {
  catch {close $fd}
  catch {file delete $file}
  unset data fd file
} -result "1\n2\n3\nhere\n"}

###############################################################################

source [file join [file normalize [file dirname [info script]]] epilogue.eagle]
